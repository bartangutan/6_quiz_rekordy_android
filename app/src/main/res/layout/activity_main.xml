<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8A966"
    tools:context=".MainActivity">

    <TextView
        android:layout_marginTop="30dp"
        android:layout_margin="10dp"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textFontWeight="600"
        android:layout_gravity="center"
        android:background="#FF4800"
        android:textColor="@color/white"
        android:text="REKORDY ŚWIATA" />

    <TextView
        android:id="@+id/textViewDziedzina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="TextView" />

    <TextView
        android:id="@+id/textViewRekordzista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="TextView" />

    <TextView
        android:id="@+id/textViewRok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="TextView" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewWynik1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Rekordowy wynik: " />

        <TextView
            android:id="@+id/textViewWynik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="TextView" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonNastepny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#F2762D"
        android:gravity="center"
        android:layout_gravity="center"
        android:text="Następny rekord >>>>>>" />

    <TextView
        android:id="@+id/textViewPorownaj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textFontWeight="600"
        android:background="#FF4800"
        android:textColor="@color/white"
        android:layout_margin="10dp"
        android:padding="5dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="Porównaj z rekordem" />




    <EditText
        android:id="@+id/editTextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="Twój wynik" />

    <Button
        android:id="@+id/buttonPorownaj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#F2762D"
        android:gravity="center"
        android:layout_gravity="center"
        android:text="PORÓWNAJ" />


    <TextView
        android:id="@+id/textViewPorownanyWynik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="" />

</LinearLayout>